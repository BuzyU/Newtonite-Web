# Web Client Configuration
# In development, Vite proxies /api requests to http://localhost:3000
# In production, Vercel proxies /api requests to Render via web/vercel.json
NODE_ENV=development

# Realtime / API Configuration
# Optional: explicitly override API base URL if not using proxy rewrites
# VITE_API_URL=https://newtonite-api-6sc7.onrender.com
