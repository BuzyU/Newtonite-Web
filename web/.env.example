# Web Client Configuration
# In development, Vite proxies /api requests to http://localhost:3000
# In production, Vercel proxies /api requests to Render via web/vercel.json
NODE_ENV=development

# Google OAuth via Supabase (Optional)
# Set to 'true' to display the "Continue with Google" button on /login
VITE_GOOGLE_LOGIN_ENABLED=false
# Required only when VITE_GOOGLE_LOGIN_ENABLED=true
# Only public anon keys are exposed to the client bundle
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sbp_your_supabase_publishable_anon_key
